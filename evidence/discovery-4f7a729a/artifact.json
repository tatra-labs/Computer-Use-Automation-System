{
  "kind": "capability",
  "schemaVersion": "handspan.capability/v1",
  "id": "cap_open_member_subaccount",
  "name": "open_member_subaccount",
  "version": 1,
  "title": "Open a secondary savings sub-account for a member and reach the posting confirmation",
  "description": "Open a new secondary savings sub-account for member {{memberId}} with nickname {{nickname}} and an initial deposit of {{initialDeposit}}, and reach the posting confirmation screen showing the reference number. Start from member inquiry: look the member up first, then use sub-account maintenance. (recorded against meridian-core variant \"base\")",
  "app": {
    "productId": "meridian-core",
    "variant": "base",
    "surface": "web",
    "entry": "http://127.0.0.1:8078/",
    "profile": "app-profiles/meridian-core.json"
  },
  "contract": {
    "inputs": [
      {
        "name": "memberId",
        "type": "integer",
        "required": true,
        "description": "The institution's 5-digit member number",
        "sensitivity": "internal",
        "pattern": "^\\d{5}$",
        "example": "23456"
      },
      {
        "name": "nickname",
        "type": "string",
        "required": true,
        "description": "Operator-facing nickname for the new sub-account",
        "sensitivity": "internal",
        "pattern": "^[A-Za-z0-9 ._-]{1,20}$",
        "example": "HOLIDAY FUND"
      },
      {
        "name": "initialDeposit",
        "type": "money",
        "required": true,
        "description": "Opening deposit amount in dollars",
        "sensitivity": "internal",
        "pattern": "^\\d+(\\.\\d{2})?$",
        "example": "25.00"
      }
    ],
    "outputs": [
      {
        "name": "reference_number",
        "type": "string",
        "description": "The core-generated reference number for the sub-account opening and its initial deposit posting.",
        "sensitivity": "internal",
        "required": true,
        "source": {
          "kind": "controlText",
