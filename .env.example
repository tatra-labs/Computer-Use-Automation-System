# Target-app service account. These are credentials for the LOCAL mock app only.
# The value is read at replay time by env-var NAME; artifacts never contain it.
TARGET_APP_USER=svc.agent
TARGET_APP_PASSWORD=Passw0rd!demo

# Discovery planner. If set, the Anthropic Messages API is used (claude-opus-5).
# If unset, the locally authenticated Claude Code CLI is used as the model endpoint.
# ANTHROPIC_API_KEY=sk-ant-...
